      "fieldtype": "Section Break",
      "label": "Fixed Value Settings"
    },
    {
      "depends_on": "eval:doc.generator_type === 'Fixed Value'",
      "description": "The fixed value to use for all matching fields",
      "fieldname": "fixed_value",
      "fieldtype": "Small Text",
      "label": "Fixed Value",
      "mandatory_depends_on": "eval:doc.generator_type === 'Fixed Value'"
    },
    {
      "default": "String",
      "depends_on": "eval:doc.generator_type === 'Fixed Value'",
      "description": "How to interpret the fixed value",
      "fieldname": "fixed_value_type",
      "fieldtype": "Select",
      "label": "Fixed Value Type",
      "options": "String\nInteger\nFloat\nBoolean\nJSON"
    },
    {
      "collapsible": 1,
      "depends_on": "eval:doc.generator_type === 'Pattern'",
      "fieldname": "pattern_settings_section",
      "fieldtype": "Section Break",
      "label": "Pattern Settings"
    },
