      "fieldname": "faker_provider",
      "fieldtype": "Data",
      "label": "Faker Provider",
      "mandatory_depends_on": "eval:doc.generator_type === 'Faker'"
    },
    {
      "depends_on": "eval:doc.generator_type === 'Faker'",
      "description": "Faker method to call (e.g., 'name', 'email', 'phone_number')",
      "fieldname": "faker_method",
      "fieldtype": "Data",
      "label": "Faker Method",
      "mandatory_depends_on": "eval:doc.generator_type === 'Faker'"
    },
    {
      "fieldname": "column_break_faker",
      "fieldtype": "Column Break"
    },
    {
      "depends_on": "eval:doc.generator_type === 'Faker'",
