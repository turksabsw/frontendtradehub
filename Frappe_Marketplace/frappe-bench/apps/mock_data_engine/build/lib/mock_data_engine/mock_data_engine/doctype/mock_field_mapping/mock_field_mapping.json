      "fieldname": "pattern_template",
      "fieldtype": "Data",
      "label": "Pattern Template",
      "mandatory_depends_on": "eval:doc.generator_type === 'Pattern'"
    },
    {
      "depends_on": "eval:doc.generator_type === 'Pattern'",
