      "fieldname": "faker_locale",
      "fieldtype": "Select",
      "label": "Faker Locale Override",
      "options": "\ntr_TR\nen_US\nen_GB\nde_DE\nfr_FR\nes_ES\nit_IT\npt_BR\nja_JP\nzh_CN\nar_SA"
    },
    {
      "depends_on": "eval:doc.generator_type === 'Faker'",
