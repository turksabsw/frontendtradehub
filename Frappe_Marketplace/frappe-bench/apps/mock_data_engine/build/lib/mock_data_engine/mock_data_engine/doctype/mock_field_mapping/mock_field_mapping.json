  "fields": [
    {
      "fieldname": "basic_info_section",
      "fieldtype": "Section Break",
      "label": "Basic Information"
    },
    {
      "description": "Unique name for this field mapping rule",
      "fieldname": "mapping_name",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Mapping Name",
      "reqd": 1,
      "unique": 1
    },
    {
      "default": "1",
      "description": "Enable or disable this mapping",
      "fieldname": "enabled",
      "fieldtype": "Check",
      "in_list_view": 1,
      "label": "Enabled"
    },
    {
      "fieldname": "column_break_basic",
      "fieldtype": "Column Break"
    },
    {
      "default": "100",
      "description": "Higher priority mappings are evaluated first (1-1000). Use lower numbers for more specific patterns.",
      "fieldname": "priority",
      "fieldtype": "Int",
      "in_list_view": 1,
      "label": "Priority"
    },
    {
      "description": "Description of what this mapping does",
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "matching_criteria_section",
      "fieldtype": "Section Break",
      "label": "Matching Criteria"
    },
    {
      "default": "Contains",
      "description": "How to match the field pattern against field names",
      "fieldname": "match_type",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "Match Type",
      "options": "Exact\nContains\nStarts With\nEnds With\nRegex",
      "reqd": 1
    },
    {
      "description": "Pattern to match against field names. For Regex match type, use a valid regex pattern.",
      "fieldname": "field_pattern",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Field Pattern",
      "reqd": 1
    },
    {
      "fieldname": "column_break_matching",
      "fieldtype": "Column Break"
    },
    {
      "description": "Comma-separated list of Frappe field types this mapping applies to (e.g., 'Data,Small Text'). Leave empty to match all field types.",
      "fieldname": "field_types",
      "fieldtype": "Data",
      "label": "Field Types"
    },
    {
      "description": "Comma-separated list of DocType names to limit this mapping to. Leave empty to apply globally.",
      "fieldname": "target_doctypes",
      "fieldtype": "Small Text",
      "label": "Target DocTypes"
    },
    {
      "fieldname": "generator_configuration_section",
      "fieldtype": "Section Break",
      "label": "Generator Configuration"
    },
    {
      "default": "Faker",
      "description": "The type of data generator to use for matching fields",
      "fieldname": "generator_type",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "Generator Type",
      "options": "Faker\nFixed Value\nPattern\nRange\nSelect Options\nTurkish Validator\nLLM\nCustom Function",
      "reqd": 1
    },
    {
      "fieldname": "column_break_generator",
      "fieldtype": "Column Break"
    },
    {
      "description": "The specific generator method to use (optional, for documentation)",
      "fieldname": "generator_method",
      "fieldtype": "Data",
      "label": "Generator Method",
      "read_only_depends_on": "eval:doc.generator_type !== 'Custom Function'"
    },
    {
      "collapsible": 1,
      "depends_on": "eval:doc.generator_type === 'Faker'",
      "fieldname": "faker_settings_section",
      "fieldtype": "Section Break",
      "label": "Faker Settings"
    },
    {
      "depends_on": "eval:doc.generator_type === 'Faker'",
